# Chiave di cifratura Fernet per credenziali — DEVE essere persistente
# Genera con: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# JWT secret — cambia in produzione
JWT_SECRET=change-me-in-production

# Flask secret key
FLASK_SECRET_KEY=change-me-in-production

# SMTP per notifiche ai beneficiari (opzionale — senza, le email vanno in dry-run)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
